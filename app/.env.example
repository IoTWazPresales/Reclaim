# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Scheme (default: reclaim)
EXPO_PUBLIC_APP_SCHEME=reclaim

# Sentry (optional - for crash reporting)
# Get your DSN from https://sentry.io → Create Project → React Native
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
